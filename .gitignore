# Virtualenv and build output
.venv/
*.egg-info/
build/
dist/

# Derived data: rebuilt from data/ with `python -m odom_ml.data.build`.
# Hundreds of MB of resampled float64 arrays, regenerable in about a minute.
.cache/
work/

# The bag dataset (~824 MB of rosbag2 sqlite3) and the generated feature tables
# are now tracked in git, so a fresh clone has everything the pipeline needs.
# To restore them into an existing clone instead of cloning:
#   robocopy <dataset>\data  data\   /E
#   robocopy <dataset>\tram_vehicle_msgs  data\tram_vehicle_msgs  /E

# Training tables are large and fully regenerable
artifacts/tables/

# Pickles are not a safe interchange format; the JSON trees in
# artifacts/models/speed_slip/ are what the C++ node consumes.
*.joblib

# Superseded by artifacts/models/speed_slip/
artifacts/models/traction_v1/

# Logs and scratch
*.log
__pycache__/
*.py[cod]
.pytest_cache/

# Synthetic feature dumps produced by the export self-check; never committed.
test_dump/
test_out/
models_moving/


# single-run experiment output, not the shipped artefact
models_final_only/

models_probe/

train.log
clip_stats.csv

# Local isolated test env on this machine only, never commit.
.wsl/
.venv_test/
.pip_cache/
.tmp/

# Web frontend build output and deps (rebuilt with pnpm install + build).
web/frontend/node_modules/
web/frontend/dist/
web/backend/__pycache__/
web/backend/.venv/

